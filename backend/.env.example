# Copy this file to .env and fill in real values before running.

PORT=4000

# Long random string used to sign session tokens. Generate your own,
# e.g. `openssl rand -hex 32` — never reuse the example below in production.
JWT_SECRET=replace-this-with-a-long-random-string

# Where your Postgres database lives. Get this from Render after creating
# a free PostgreSQL instance — see backend/README.md for exact steps.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Comma-separated list of origins allowed to call this API
# (your deployed front-end URL(s), plus http://localhost for local dev).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Identity verification (Stripe Identity) --------------------------
# Get these from your Stripe Dashboard after creating an account:
# https://dashboard.stripe.com/apikeys (secret key) and
# https://dashboard.stripe.com/webhooks (add an endpoint pointing at
# https://your-backend-url/api/kyc/webhook, subscribed to the
# identity.verification_session.verified event, then copy its signing secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Your deployed frontend URL — used to build the page Stripe sends users
# back to after they finish (or abandon) identity verification.
FRONTEND_URL=http://localhost:5500

# --- Payments (NOT wired up — see src/routes/wallet.js) -------------------
# Stripe Connect is NOT usable for this business category (skill-based
# cash competition is on Stripe's restricted list even for licensed
# operators) — see backend/README.md for the realistic options and what
# their onboarding actually requires.
