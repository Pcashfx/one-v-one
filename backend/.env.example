# Copy this file to .env and fill in real values before running.

PORT=4000

# Long random string used to sign session tokens. Generate your own,
# e.g. `openssl rand -hex 32` — never reuse the example below in production.
JWT_SECRET=replace-this-with-a-long-random-string

# Where the SQLite database file is written.
DATABASE_PATH=./data/onevone.db

# Comma-separated list of origins allowed to call this API
# (your deployed front-end URL(s), plus http://localhost for local dev).
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# --- Payments (NOT wired up — see src/routes/wallet.js) -------------------
# This project intentionally does not move real money. To go live you'd
# create your own account with a licensed payment/escrow provider (e.g.
# Stripe Connect, or a specialist skill-gaming payments partner) under your
# own business entity, complete their KYC/compliance review, and put your
# real keys here. Only do this after confirming with a lawyer that running
# paid skill-based competitions is permitted in the jurisdictions you plan
# to operate in.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
